# Optional: required only when observability.wandb.enabled or
# observability.weave.enabled is true in the experiment YAML.
WANDB_API_KEY=YOUR_WANDB_API_KEY

# Optional: omit to use the default W&B entity. Project and run identity belong
# in YAML so the experiment remains reproducible.
WANDB_ENTITY=YOUR_WANDB_ENTITY

# Optional for public models. PI0/PI0.5 require this after accepting the gated
# google/paligemma-3b-pt-224 tokenizer terms on Hugging Face.
HF_TOKEN=YOUR_HUGGINGFACE_TOKEN

# Optional machine-local storage root for large datasets, model caches,
# environments, checkpoints, and run outputs. Keep this outside the Git
# worktree on shared clusters; experiment semantics remain in YAML.
ART_EMBODIED_STORAGE_ROOT=/mnt/data/${USER}/art-embodied
# User-installed LIBERO-Plus checkout; provision with scripts/setup-libero-plus.sh.
ART_EMBODIED_LIBERO_PLUS_ROOT=/mnt/data/${USER}/art-embodied/external/LIBERO-plus
ART_EMBODIED_LIBERO_PLUS_IMAGEMAGICK_PREFIX=/mnt/data/${USER}/art-embodied/external/libero-plus-imagemagick
# Optional cluster safety gate used by storage-aware launch scripts.
ART_EMBODIED_MIN_FREE_GIB=100
# Optional host compatibility directory containing GLVND libEGL.so.1.
ART_EMBODIED_EGL_LIBRARY_DIR=

# Optional explicit override for the pinned GR00T RoboCasa dataset. By default
# scripts derive this path from ART_EMBODIED_STORAGE_ROOT.
# ART_EMBODIED_ROBOCASA_DATASET_ROOT=/path/to/PhysicalAI-Robotics-GR00T-Teleop-Sim

# Optional: required before installing or running the experimental RoboLab /
# Isaac Sim adapter. Set this only after reviewing and accepting NVIDIA's
# Omniverse EULA linked by scripts/install-robolab-runtime.sh.
OMNI_KIT_ACCEPT_EULA=YES
