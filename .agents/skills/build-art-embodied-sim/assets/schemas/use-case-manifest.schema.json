{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-embodied.dev/schemas/use-case-manifest-v1.json",
  "title": "ART-Embodied Use Case Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "status",
    "task_instruction",
    "robot_profile",
    "created_at_utc",
    "reference_inputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {
      "enum": [
        "draft",
        "provider_exported",
        "task_ready",
        "lerobot_ready",
        "art_embodied_ready",
        "validated"
      ]
    },
    "task_instruction": {"type": "string", "minLength": 1},
    "robot_profile": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "reference_inputs": {"type": "array"},
    "known_scale": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value_m", "description"],
          "properties": {
            "value_m": {"type": "number", "exclusiveMinimum": 0},
            "description": {"type": "string", "minLength": 1}
          }
        },
        {"type": "null"}
      ]
    },
    "artifacts": {"type": "object"}
  }
}
