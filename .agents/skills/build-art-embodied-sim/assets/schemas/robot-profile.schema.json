{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://art-embodied.dev/schemas/robot-profile-v1.json",
  "title": "ART-Embodied RobotProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "simulator",
    "asset",
    "control",
    "observations",
    "frames",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "simulator": {"const": "mujoco"},
    "asset": {
      "type": "object",
      "required": ["source", "revision", "path"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"]}
      }
    },
    "control": {
      "type": "object",
      "required": ["mode", "frequency_hz", "action_order", "units", "limits"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "action_order": {"type": "array", "minItems": 1},
        "units": {"type": "array", "minItems": 1},
        "limits": {"type": "array", "minItems": 1}
      }
    },
    "observations": {"type": "object", "minProperties": 1},
    "frames": {"type": "object", "minProperties": 2},
    "safety": {"type": "object", "minProperties": 1}
  }
}
